# DevHub 2.0 backend settings (copy to backend/.env for local development).
# backend/.env is git-ignored. The legacy backend reads different keys (DB_USER, ...)
# from the same file; the new app ignores them.

APP_ENV=local
DATABASE_URL=mysql+pymysql://devhub_dev:devhub_local_dev@127.0.0.1:3307/devhub_dev
LOG_LEVEL=INFO
# JSON list of allowed browser origins. Empty in local dev (the Vite proxy is used).
CORS_ORIGINS=[]

# Used only by the test suite. Must point at a database whose name ends with _test.
TEST_DATABASE_URL=mysql+pymysql://devhub_test:devhub_local_test@127.0.0.1:3307/devhub_test
