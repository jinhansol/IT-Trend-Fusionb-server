# DevHub 2.0 frontend settings (copy to frontend/.env.local if you need to change them).
# Base URL used by src/api/client.js. Keep "/api" for the Vite proxy and same-origin deploys.
VITE_API_BASE_URL=/api
# Where the Vite dev server forwards /api requests (the new FastAPI app).
VITE_DEV_API_PROXY_TARGET=http://127.0.0.1:8000
